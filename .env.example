# Optional. Leave empty to run in demo mode: menu, logins and orders are kept in
# server memory, so everything works but resets when the server restarts.
#
# Fill both values to store data in Supabase (free) — see README step "Database".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Used to sign the login cookie. Any long random string works.
SESSION_SECRET="change-me-to-a-long-random-string"
